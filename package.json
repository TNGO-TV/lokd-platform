{
  "name": "lokd-security",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-loader=./tests/cloudflare-loader.mjs --test tests/*.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "test:accounts": "node scripts/test-accounts.mjs",
    "check:security": "bash scripts/security-check.sh"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.1",
    "@clerk/react": "^6.15.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.33",
    "@cloudflare/vite-plugin": "1.54.9",
    "@cloudflare/workers-types": "5.20260915.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  },
  "type": "module",
  "displayName": "LOKD Security Platform",
  "overrides": {
    "next": {
      "sharp": "0.35.5"
    },
    "vinext": {
      "image-size": "2.0.4"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
