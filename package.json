{
  "name": "lokd-security",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --import ./tests/register-cloudflare.mjs --test tests/*.test.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "test:accounts": "node scripts/test-accounts.mjs",
    "check:security": "bash scripts/security-check.sh"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.1",
    "@clerk/react": "^6.15.1",
    "drizzle-orm": "0.45.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.33",
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "file:vendor/drizzle-kit",
    "eslint": "10.12.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.2.1",
    "vite": "8.3.5",
    "wrangler": "4.154.0",
    "typescript-eslint": "8.71.2",
    "eslint-plugin-import-x": "file:vendor/eslint-plugin-import-x",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "@lokd/eslint-plugin-react-compat": "file:vendor/eslint-plugin-react-compat",
    "@next/eslint-plugin-next": "file:vendor/next-eslint-plugin-next",
    "magic-string": "0.30.21",
    "@jridgewell/trace-mapping": "0.3.31",
    "eslint-import-resolver-node": "0.3.10",
    "eslint-import-resolver-typescript": "3.10.1"
  },
  "type": "module",
  "displayName": "LOKD Security Platform",
  "overrides": {
    "next": {
      "sharp": "0.35.5"
    },
    "vinext": {
      "image-size": "2.0.4"
    },
    "vite-plugin-dynamic-import": "file:vendor/vite-plugin-dynamic-import",
    "satori": {
      "fflate": "0.7.5"
    },
    "eslint": {
      "minimatch": "11.0.3"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    },
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "11.0.3"
    }
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261023.1": true
  }
}
