# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# Local Worker secrets and Clerk project link
.dev.vars*
.clerk/

# Automated account test reports (may contain test identities)
/test-results/
/playwright-report/

/tests/accounts/test-results/

# Local combined browser diagnostics
/tests/integrated-browser/test-results/

# Raw validation output belongs outside the source tree.
/acceptance/**/*.log
/docs/**/*.log
