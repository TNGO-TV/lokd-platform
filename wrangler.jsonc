// Email secret: LOKD_SMTP_PASSWORD (the lokd.co.za mailbox password).
// Optional owner-supplied secrets: LOKD_BACKUP_TOKEN_SHA256, VERIFYNOW_API_KEY, RESEND_API_KEY (Resend alternative only).
// Reserved, disconnected payment secret: PAYSTACK_LIVE_SECRET_KEY. Do not provision.
// Purpose and provisioning status: docs/production-secrets.md. Values never belong here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Client account and delivery secrets (set with wrangler secret; never store values here):
  // LOKD_SMTP_PASSWORD, LOKD_EMAIL_FROM, LOKD_QUOTE_EMAIL_FROM, LOKD_TEAM_EMAIL.
  // SMTP mailbox settings: LOKD_SMTP_HOST (e.g. mail.lokd.co.za), LOKD_SMTP_PORT (465),
  // LOKD_SMTP_USER (full mailbox address). RESEND_API_KEY is an optional alternative.
  // Operations access: LOKD_OPERATIONS_ACCESS_JSON, LOKD_OWNER_ACCESS_JSON.
  // Client payment configuration remains disconnected: PAYSTACK_LIVE_SECRET_KEY,
  // LOKD_COLLECTION_LIVE_ENABLED, LOKD_EFT_BANK_NAME, LOKD_EFT_ACCOUNT_NAME,
  // LOKD_EFT_ACCOUNT_NUMBER, LOKD_EFT_BRANCH_CODE, LOKD_EFT_ACCOUNT_TYPE.
  "name": "lokd-security",
  "account_id": "d7000a5708fdeb67be6e21ee40e9105e",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "keep_vars": true,
  // Public-site runtime settings: LOKD_EMAIL_FROM (the SMTP mailbox address),
  // LOKD_TEAM_EMAIL (operations recipient). LOKD_EMAIL_PROVIDER is optional
  // (smtp or resend); with the SMTP settings present, SMTP is used.
  "upload_source_maps": true,
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "images": {
    "binding": "IMAGES"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  // Officer secrets (set with wrangler secret put; never store values here):
  // LOKD_SMTP_PASSWORD, VERIFYNOW_API_KEY
  // Officer email config: LOKD_EMAIL_FROM (the SMTP mailbox address).
  // Identity config: VERIFYNOW_IDENTITY_POLICY_REFERENCE,
  // VERIFYNOW_IDENTITY_VALIDITY_DAYS (1–365).
  // Operations secrets: LOKD_SMTP_PASSWORD (set with wrangler secret put).
  // Email configuration: LOKD_EMAIL_FROM must equal the SMTP mailbox (or an alias it may send as).
  // Payment provider keys remain unset.
  "vars": {
    "LOKD_PUBLIC_ORIGIN": "https://lokd.co.za",
    "LOKD_APP_STAGE": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lokd-security",
      "database_id": "e3f215fa-54e1-4a4b-b6bc-7a6b41bba79c",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "lokd-security"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "preview_urls": false,
  "routes": [
    {
      "pattern": "lokd.co.za",
      "custom_domain": true
    },
    {
      "pattern": "www.lokd.co.za",
      "custom_domain": true
    },
    {
      "pattern": "portal.lokd.co.za",
      "custom_domain": true
    },
    {
      "pattern": "officers.lokd.co.za",
      "custom_domain": true
    },
    {
      "pattern": "operations.lokd.co.za",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "LOKD_SMTP_PASSWORD",
      "LOKD_ROLE_ACCESS_JSON",
      "LOKD_OPERATIONS_ACCESS_JSON",
      "LOKD_OWNER_ACCESS_JSON"
    ]
  }
}
